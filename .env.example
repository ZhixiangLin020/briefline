# Required by Guardian ingestion.
GUARDIAN_API_KEY=replace_me

# Required by PostgreSQL-backed stages and the frontend.
DATABASE_URL=postgresql://user:password@host:5432/database

# Required by evidence retrieval and similarity search.
OPENAI_API_KEY=replace_me
WEAVIATE_URL=https://replace_me.weaviate.network
WEAVIATE_API_KEY=replace_me

# Required only by taxonomy generation and faithfulness evaluation.
GOOGLE_API_KEY=replace_me

# Optional for ColBERT model downloads.
HF_TOKEN=replace_me

# User-selectable model and artifact paths.
ADAPTER_PATH=/path/to/existing/adapter
BASE_MODEL_PATH=Qwen/Qwen2.5-3B-Instruct
JUDGE_MODEL_PATH=Qwen/Qwen3-14B
RAG_ARTIFACT_DIR=/path/to/rag_artifacts
RAG_TEMP_ROOT=/path/to/rag_runtime

# Optional frontend branding.
SITE_NAME=Briefline
SITE_TAGLINE=Clear summaries. Connected coverage.
THEME_ACCENT_COLOR=#4F46E5
